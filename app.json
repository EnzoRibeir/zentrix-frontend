{
  "expo": {
    "name": "Zentrix",
    "slug": "zentrix-app",
    "owner": "mandrak24",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/db796ad4-f760-4d5d-9314-18f636a51620"
    },
    "scheme": "zentrix",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zentrix.financas"
    },
    "android": {
      "package": "com.zentrix.financas",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "zentrix",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Zentrix — Controle Financeiro Inteligente",
      "shortName": "Zentrix",
      "lang": "pt-BR",
      "themeColor": "#274C77",
      "backgroundColor": "#EFF2F4",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#274C77",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Zentrix"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "db796ad4-f760-4d5d-9314-18f636a51620"
      }
    }
  }
}
